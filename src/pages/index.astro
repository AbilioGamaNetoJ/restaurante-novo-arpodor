---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { restaurant } from '../data/restaurant';
import heroFacade from '../assets/hero-facade.png';
import logo from '../assets/logo.jpg';
import anchova from '../assets/anchova.jpg';
import iscaPeixe from '../assets/isca-peixe.jpg';
import camaraoMilanesa from '../assets/camarao-milanesa.jpg';
import bifeAcebolado from '../assets/bife-acebolado.jpg';
import hamburguerArpoador from '../assets/hamburguer-arpoador.jpg';
import cafe from '../assets/cafe.jpg';
import porcaoMista from '../assets/porcao-mista.jpg';

const description =
  'Restaurante na Armação do Pântano do Sul, Florianópolis. Café, prato feito, porções e lanches. Terça a domingo, das 8h à meia-noite.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.name,
  logo: 'https://novoarpoador.vercel.app/logo.jpg',
  telephone: '+55 48 99122-8857',
  priceRange: '$$',
  servesCuisine: ['Brasileira', 'Frutos do mar', 'Lanches'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: restaurant.address,
    addressLocality: 'Florianópolis',
    addressRegion: 'SC',
    postalCode: restaurant.postalCode,
    addressCountry: 'BR'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -27.7503693,
    longitude: -48.5032299
  },
  sameAs: [restaurant.instagram, restaurant.maps],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 5,
    reviewCount: restaurant.reviewCount,
    bestRating: 5
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '08:00',
      closes: '00:00'
    }
  ]
};

const gallery = [
  { image: anchova, ...restaurant.dishes[0] },
  { image: iscaPeixe, ...restaurant.dishes[1] },
  { image: camaraoMilanesa, ...restaurant.dishes[2] },
  { image: bifeAcebolado, ...restaurant.dishes[3] },
  { image: hamburguerArpoador, ...restaurant.dishes[4] },
  { image: cafe, ...restaurant.dishes[5] },
  { image: porcaoMista, ...restaurant.dishes[6] }
];

const services = [
  { icon: 'coffee', number: '01', title: 'Café', copy: 'A partir das 8h, todo dia que a gente abre.' },
  { icon: 'plate', number: '02', title: 'Pratos feitos', copy: 'Anchova, bife acebolado e frango — com arroz, feijão e salada.' },
  { icon: 'shrimp', number: '03', title: 'Porções', copy: 'Isca de peixe, camarão à milanesa e a mista para a mesa toda.' },
  { icon: 'snack', number: '04', title: 'Lanches', copy: 'Hambúrguer Arpoador e outros, para comer aqui ou levar.' }
];

const ribbonItems = ['CAFÉ FRESQUINHO', 'ALMOÇO CASEIRO', 'PEIXE DA ILHA', 'PORÇÕES PARA DIVIDIR', 'DELIVERY E RETIRADA'];

const navItems = [
  { href: '#cardapio', label: 'Cardápio' },
  { href: '#pratos', label: 'Pratos' },
  { href: '#experiencia', label: 'Experiência' },
  { href: '#pedido', label: 'Como pedir' },
  { href: '#avaliacoes', label: 'Avaliações' },
  { href: '#onde', label: 'Onde fica' },
  { href: '#peca', label: 'Peça agora' }
];
---

<BaseLayout title={`${restaurant.name} | Armação, Florianópolis`} {description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

  <header class="site-header" data-header>
    <div class="shell nav-wrap">
      <a class="brand" href="#inicio" aria-label={`${restaurant.name}, início`}>
        <Image class="brand-logo" src={logo} alt="" widths={[80, 120, 160]} sizes="42px" loading="eager" fetchpriority="high" />
      </a>
      <nav class="desktop-nav" aria-label="Navegação principal">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
      <div class="nav-actions">
        <a class="nav-order" href={restaurant.menu} target="_blank" rel="noreferrer">Ver cardápio <span aria-hidden="true">↗</span></a>
        <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span></span><span></span></button>
      </div>
    </div>
    <nav class="mobile-menu" id="mobile-menu" aria-label="Navegação mobile" data-mobile-menu>
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
  </header>

  <main id="inicio">
    <section class="hero" aria-labelledby="hero-title">
      <Image class="hero-image" src={heroFacade} alt="Fachada do Restaurante Novo Arpoador na Praia da Armação" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="hero-scrim"></div>
      <div class="shell hero-layout">
        <div class="hero-content">
          <p class="eyebrow light"><span></span> Praia da Armação · Floripa</p>
          <h1 id="hero-title">Peixe fresco e comida caseira na <em>Armação</em></h1>
          <p class="hero-copy">Café da manhã, prato feito no almoço, porções e lanches até tarde. Av. Antônio Borges dos Santos, 717 — a dois minutos da praia.</p>
          <div class="hero-actions">
            <a class="button button-sun" href={restaurant.menu} target="_blank" rel="noreferrer">Ver cardápio e pedir <span aria-hidden="true">→</span></a>
            <a class="button button-glass" href={restaurant.directions} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
              Como chegar
            </a>
          </div>
          <p class="open-status" data-open-status><i></i><span>Terça a domingo, das 8h à meia-noite</span></p>
        </div>
      </div>
      <a class="scroll-cue" href="#cardapio" aria-label="Descobrir o cardápio"><span>↓</span> Role para descobrir</a>
    </section>

    <div class="flavor-ribbon" aria-label="Destaques do restaurante">
      <div>
        {ribbonItems.map((item) => (
          <><span>{item}</span><i>✦</i></>
        ))}
        <span class="ribbon-dup">
          {ribbonItems.map((item) => (
            <><span>{item}</span><i>✦</i></>
          ))}
        </span>
      </div>
    </div>

    <section class="intro-section section" id="cardapio" aria-labelledby="cardapio-title">
      <div class="shell intro-grid reveal">
        <div>
          <p class="eyebrow"><span></span> Tem sabor para todo momento</p>
          <h2 id="cardapio-title">Seu novo ponto de encontro <em>na Armação.</em></h2>
        </div>
        <div class="intro-right">
          <p>Receitas bem servidas, clima leve e aquele atendimento que faz você querer voltar. Para almoçar, beliscar ou encontrar os amigos.</p>
          <a class="text-link" href={restaurant.menu} target="_blank" rel="noreferrer">Explorar o cardápio <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="shell service-list reveal" aria-label="Opções do restaurante">
        {services.map((service) => (
          <a class="service-card" href={restaurant.menu} target="_blank" rel="noreferrer">
            <span class="service-number">{service.number}</span>
            <span class="service-icon" aria-hidden="true" data-icon={service.icon}>
              {service.icon === 'coffee' && <svg viewBox="0 0 32 32"><path d="M6 11h17v8a7 7 0 0 1-7 7h-3a7 7 0 0 1-7-7v-8Z"/><path d="M23 14h2a4 4 0 0 1 0 8h-3M10 7c0-2 2-2 2-4M17 7c0-2 2-2 2-4"/></svg>}
              {service.icon === 'plate' && <svg viewBox="0 0 32 32"><circle cx="16" cy="17" r="11"/><circle cx="16" cy="17" r="6"/><path d="M5 28h22"/></svg>}
              {service.icon === 'shrimp' && <svg viewBox="0 0 32 32"><path d="M26 9c0 10-5 17-13 17-5 0-8-3-8-7 0-3 2-5 5-5h8"/><path d="M20 7c2-2 5-1 6 2M11 14c0 5 3 8 8 8M8 25l-2 3M12 26v3"/><circle cx="23" cy="10" r="1"/></svg>}
              {service.icon === 'snack' && <svg viewBox="0 0 32 32"><path d="M5 15c1-6 5-9 11-9s10 3 11 9H5ZM5 21h22M7 25h18M4 18h24"/><path d="M11 11h.1M16 9h.1M21 11h.1"/></svg>}
            </span>
            <span class="service-copy"><strong>{service.title}</strong><small>{service.copy}</small></span>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="gallery-section section" id="pratos" aria-labelledby="pratos-title">
      <div class="shell section-heading row-heading reveal">
        <div>
          <p class="eyebrow"><span></span> Direto da nossa cozinha</p>
          <h2 id="pratos-title">Bonito de ver.<br /><em>Melhor ainda de provar.</em></h2>
        </div>
        <div class="heading-aside">
          <p>Ingredientes frescos e pratos que chegam à mesa cheios de cor e sabor.</p>
          <a class="text-link" href={restaurant.instagram} target="_blank" rel="noreferrer">Siga no Instagram <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="shell food-grid reveal">
        {gallery.map((item, index) => (
          <a class:list={['food-card', `food-card-${index + 1}`]} href={restaurant.menu} target="_blank" rel="noreferrer">
            <Image src={item.image} alt={item.title} widths={[440, 640, 960, 1200]} sizes={index === 0 || index === 6 ? '(max-width: 760px) 100vw, 60vw' : '(max-width: 760px) 50vw, 28vw'} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="food-order">Ver no cardápio ↗</span>
            <div class="food-card-label"><span>{item.label}</span><h3>{item.title}</h3></div>
          </a>
        ))}
      </div>
    </section>

    <section class="experience-section section" id="experiencia" aria-labelledby="experiencia-title">
      <div class="shell experience-wrap">
        <div class="experience-copy">
          <h2 id="experiencia-title">Do café da manhã à meia-noite</h2>
          <p>Família no almoço, amigos no petisco, lanche até tarde. A dois minutos da praia, com mesa no salão o dia inteiro.</p>
          <ol class="experience-moments">
            {restaurant.experience.map((moment) => (
              <li>
                <span>{moment.hour}</span>
                <div>
                  <strong>{moment.title}</strong>
                  <p>{moment.copy}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
        <figure class="experience-visual">
          <Image src={heroFacade} alt="Fachada do Restaurante Novo Arpoador na Praia da Armação" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 50vw" />
          <figcaption>Av. Antônio Borges dos Santos, 717 · Armação</figcaption>
        </figure>
      </div>
    </section>

    <section class="ways-section" id="pedido" aria-labelledby="pedido-title">
      <div class="shell ways-head reveal">
        <div>
          <p class="eyebrow light"><span></span> Do seu jeito</p>
          <h2 id="pedido-title">Como pedir</h2>
        </div>
        <p>O mesmo capricho, seja qual for a sua rotina.</p>
      </div>
      <div class="shell ways-list reveal">
        <article>
          <span>01</span>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M6 5v8M10 5v8M8 5v20M24 5v20M21 5v8c0 2 6 2 6 0V5"/></svg>
          <h3>No salão</h3>
          <p>Sem reserva. É só chegar, de terça a domingo.</p>
        </article>
        <article>
          <span>02</span>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M5 13h22l-2 14H7L5 13Z"/><path d="M11 13V9a5 5 0 0 1 10 0v4M4 27h24"/></svg>
          <h3>Entrega</h3>
          <p>Pelo cardápio online ou pelo WhatsApp (48) 99122-8857.</p>
        </article>
        <article>
          <span>03</span>
          <svg viewBox="0 0 32 32" aria-hidden="true"><path d="m5 17 11-9 11 9M8 15v12h16V15M12 27v-7h8v7"/></svg>
          <h3>Retirada</h3>
          <p>Faça o pedido antes e busque no balcão.</p>
        </article>
      </div>
    </section>

    <section class="reviews-section section" id="avaliacoes" aria-labelledby="avaliacoes-title" data-carousel>
      <div class="shell reviews-head reveal">
        <div>
          <p class="eyebrow"><span></span> Quem vem, recomenda</p>
          <h2 id="avaliacoes-title">O que dizem no Google</h2>
        </div>
        <div class="reviews-actions">
          <a class="rating-lockup" href={restaurant.maps} target="_blank" rel="noreferrer" aria-label="Ver avaliações no Google Maps">
            <span class="google-g">G</span>
            <span><strong>{restaurant.rating}</strong><small><b aria-label="5 estrelas">★★★★★</b> no Google</small></span>
          </a>
          <div class="carousel-buttons" aria-label="Controles das avaliações">
            <button type="button" data-carousel-prev aria-label="Avaliação anterior"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6"/></svg></button>
            <button type="button" data-carousel-next aria-label="Próxima avaliação"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6"/></svg></button>
          </div>
        </div>
      </div>
      <div class="reviews-viewport reveal" data-carousel-viewport tabindex="0" aria-label="Avaliações de clientes">
        <div class="reviews-track shell">
          {restaurant.reviews.map((review) => (
            <figure class="review-card" data-carousel-slide>
              <div class="quote-mark" aria-hidden="true">“</div>
              <div class="review-stars" aria-label="5 estrelas">★★★★★</div>
              <blockquote>{review.text}</blockquote>
              <figcaption>
                <span class="review-avatar" aria-hidden="true">{review.name.charAt(0).toUpperCase()}</span>
                <span><strong>{review.name}</strong><small>{review.when}</small></span>
                <span class="verified" title="Avaliação verificada" aria-label="Avaliação verificada">✓</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
      <div class="shell reviews-progress reveal">
        <div class="progress-dots" data-carousel-dots aria-hidden="true">
          {restaurant.reviews.map((_, index) => <i class:list={{ active: index === 0 }}></i>)}
        </div>
        <span><b data-carousel-current>01</b> / {String(restaurant.reviews.length).padStart(2, '0')}</span>
        <a href={restaurant.maps} target="_blank" rel="noreferrer">Ver todas no Google ↗</a>
      </div>
    </section>

    <section class="visit-section section" id="onde" aria-labelledby="onde-title">
      <div class="shell visit-wrap reveal">
        <div class="visit-map">
          <iframe title="Mapa de localização do Restaurante Novo Arpoador" src="https://www.google.com/maps?q=Restaurante+Novo+Arpoador,+Av.+Ant%C3%B4nio+Borges+dos+Santos,+717,+Florian%C3%B3polis,+SC&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          <a href={restaurant.directions} target="_blank" rel="noreferrer">Abrir no Google Maps <span>↗</span></a>
        </div>
        <div class="visit-copy">
          <p class="eyebrow"><span></span> Vem para a Armação</p>
          <h2 id="onde-title">Onde fica</h2>
          <div class="visit-address">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
            <address>{restaurant.address}<br />{restaurant.neighborhood}</address>
          </div>
          <div class="hours-compact">
            <div><span>Terça a domingo</span><strong>08h às 00h</strong></div>
            <div><span>Segunda-feira</span><strong class="closed">Fechado</strong></div>
          </div>
          <div class="contact-actions">
            <a class="button button-teal" href={restaurant.directions} target="_blank" rel="noreferrer">Traçar rota <span aria-hidden="true">↗</span></a>
            <a class="phone-link" href={restaurant.phoneHref}>{restaurant.phone}</a>
          </div>
        </div>
      </div>
    </section>

    <section class="closing-cta" id="peca" aria-labelledby="peca-title" style={`--closing-image: url(${heroFacade.src})`}>
      <div class="shell closing-wrap reveal">
        <h2 id="peca-title">Faça seu pedido</h2>
        <p>Cardápio online para entrega e retirada, ou venha comer no salão.</p>
        <div>
          <a class="button button-sun" href={restaurant.menu} target="_blank" rel="noreferrer">Ver cardápio <span aria-hidden="true">→</span></a>
          <a class="whatsapp-link" href={restaurant.whatsapp} target="_blank" rel="noreferrer">Pedir pelo WhatsApp ↗</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-main">
      <a class="brand brand-footer" href="#inicio" aria-label={`${restaurant.name}, início`}>
        <Image class="brand-logo" src={logo} alt="" widths={[160, 240, 320]} sizes="68px" />
      </a>
      <div class="footer-links"><a href={restaurant.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={restaurant.maps} target="_blank" rel="noreferrer">Google Maps ↗</a><a href={restaurant.menu} target="_blank" rel="noreferrer">Cardápio ↗</a><a href={restaurant.phoneHref}>{restaurant.phone}</a></div>
      <span class="footer-note">© {new Date().getFullYear()} {restaurant.name}</span>
    </div>
  </footer>

  <a class="floating-order" href={restaurant.menu} target="_blank" rel="noreferrer"><span aria-hidden="true">✦</span> Ver cardápio</a>

  <script>
    const header = document.querySelector<HTMLElement>('[data-header]');
    const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');

    const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });

    menuToggle?.addEventListener('click', () => {
      const open = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!open));
      menuToggle.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
      mobileMenu?.classList.toggle('is-open', !open);
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
      menuToggle?.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.remove('is-open');
    }));

    const status = document.querySelector<HTMLElement>('[data-open-status]');
    if (status) {
      const parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'America/Sao_Paulo', weekday: 'short', hour: 'numeric', hour12: false
      }).formatToParts(new Date());
      const day = parts.find((part) => part.type === 'weekday')?.value;
      const hour = Number(parts.find((part) => part.type === 'hour')?.value ?? 0);
      const isOpen = day !== 'Mon' && hour >= 8;
      status.classList.toggle('is-closed', !isOpen);
      const label = status.querySelector('span');
      if (label) label.textContent = isOpen ? 'Aberto agora, até meia-noite' : day === 'Mon' ? 'Fechado hoje. Abre terça às 8h' : 'Fechado agora. Abre às 8h';
    }

    const carousel = document.querySelector<HTMLElement>('[data-carousel]');
    if (carousel) {
      const viewport = carousel.querySelector<HTMLElement>('[data-carousel-viewport]');
      const slides = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
      const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const current = carousel.querySelector<HTMLElement>('[data-carousel-current]');
      const dots = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-dots] i')];

      const slideWidth = () => slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : slides[0]?.getBoundingClientRect().width ?? 0;
      const activeIndex = () => viewport ? Math.max(0, Math.min(slides.length - 1, Math.round(viewport.scrollLeft / slideWidth()))) : 0;
      const updateCarousel = () => {
        const index = activeIndex();
        if (current) current.textContent = String(index + 1).padStart(2, '0');
        dots.forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === index));
        if (prev && viewport) prev.disabled = viewport.scrollLeft < 8;
        if (next && viewport) next.disabled = viewport.scrollLeft + viewport.clientWidth >= viewport.scrollWidth - 8;
      };
      const move = (direction: number) => viewport?.scrollBy({ left: slideWidth() * direction, behavior: 'smooth' });
      prev?.addEventListener('click', () => move(-1));
      next?.addEventListener('click', () => move(1));
      viewport?.addEventListener('scroll', updateCarousel, { passive: true });
      viewport?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') { event.preventDefault(); move(-1); }
        if (event.key === 'ArrowRight') { event.preventDefault(); move(1); }
      });
      new ResizeObserver(updateCarousel).observe(viewport!);
      updateCarousel();
    }

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
  </script>
</BaseLayout>
